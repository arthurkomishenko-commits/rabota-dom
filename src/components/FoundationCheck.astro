---
/**
 * Техническая страница фазы F0.
 *
 * Что делает: показывает то, что нужно проверить в гейте F0 — направление документа,
 * зеркалирование логических свойств, каскад темы, рендер трёх письменностей.
 * Вход: локаль и строки через props. Выход: разметка.
 * Кто использует: `src/pages/index.astro`, `ru/index.astro`, `en/index.astro`.
 *
 * Строки приходят props'ами, а не импортом словаря: компонент не знает, откуда
 * берутся данные (ARCHITECTURE_PRINCIPLES §2). Удаляется в F3 вместе с неймспейсом
 * `scaffold`.
 */
import ThemeToggle from './ThemeToggle.astro';
import { LOCALES, LOCALE_DIR, LOCALE_LABEL, type Locale } from '../config/site';
import type { Dictionary } from '../data/dictionary';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: Locale;
  scaffold: Dictionary['scaffold'];
  theme: Dictionary['theme'];
}

const { locale, scaffold, theme } = Astro.props;
---

<main class="measure scaffold">
  <header class="scaffold__head">
    <p class="brand">RABOTA DOM</p>
    <ThemeToggle labelLight={theme.toLight} labelDark={theme.toDark} />
  </header>

  <h1>{scaffold.heading}</h1>

  <dl class="facts">
    <dt>{scaffold.dirLabel}</dt>
    <dd data-ltr>{LOCALE_DIR[locale]}</dd>
    <dt>{scaffold.fontLabel}</dt>
    <dd data-ltr>Rubik Variable</dd>
  </dl>

  {/* Логические свойства: полоса обязана зеркалиться в RTL без правок CSS. */}
  <section aria-label={scaffold.mirrorLabel} class="mirror">
    <span class="mirror__cell mirror__cell--start">{scaffold.start}</span>
    <span class="mirror__cell">2</span>
    <span class="mirror__cell mirror__cell--end">{scaffold.end}</span>
  </section>

  <nav class="langs" aria-label={scaffold.langNavLabel}>
    {
      LOCALES.map((code) => (
        <a
          href={getRelativeLocaleUrl(code, '/')}
          hreflang={code}
          lang={code}
          dir={LOCALE_DIR[code]}
          aria-current={code === locale ? 'page' : undefined}
        >
          {LOCALE_LABEL[code]}
        </a>
      ))
    }
  </nav>
</main>

<style>
  .scaffold {
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .scaffold__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-block-end: 1px solid var(--border-metal);
    padding-block-end: 1rem;
  }

  .brand {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-brand);
    margin: 0;
    /* Лого не переносится на узком экране — находка полировочного прохода F0. */
    white-space: nowrap;
  }

  h1 {
    margin: 0;
    font-weight: 500;
  }

  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .facts dt {
    font-weight: 500;
    color: var(--text-main);
  }

  .facts dd {
    margin: 0;
  }

  .mirror {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mirror__cell {
    border: 1px solid var(--border-metal);
    border-radius: var(--radius-base);
    background: var(--surface);
    padding-block: 0.5rem;
    padding-inline: 1rem;
    font-size: 0.875rem;
  }

  /* Акцент только на «начале» — в RTL он обязан оказаться справа. */
  .mirror__cell--start {
    border-inline-start: 3px solid var(--accent-wood);
  }

  .mirror__cell--end {
    color: var(--text-muted);
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .langs a {
    color: var(--accent-wood);
    text-underline-offset: 0.2em;
  }

  .langs a[aria-current='page'] {
    color: var(--text-muted);
    text-decoration: none;
  }
</style>
