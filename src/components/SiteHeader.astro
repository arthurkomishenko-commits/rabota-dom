---
/**
 * Шапка сайта: логотип, основная навигация, переключатель языка, тема.
 *
 * Вход: локаль, словарь навигации, подписи темы. Выход: `<header>`.
 * Кто использует: `src/layouts/PageLayout.astro`.
 *
 * Навигация строится из `NAV_ORDER` конфига, а не из строк по месту: страница,
 * которой ещё нет в карте маршрутов, не появится в меню случайно.
 */
import ThemeToggle from './ThemeToggle.astro';
import { LOCALES, LOCALE_DIR, LOCALE_LABEL, NAV_ORDER, ROUTES, type Locale } from '../config/site';
import type { Dictionary } from '../data/dictionary';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: Locale;
  nav: Dictionary['nav'];
  theme: Dictionary['theme'];
  /** Ключ текущего маршрута — для aria-current. */
  current?: keyof typeof ROUTES;
}

const { locale, nav, theme, current } = Astro.props;
---

<header class="header">
  <div class="header__row">
    <a class="brand" href={getRelativeLocaleUrl(locale, ROUTES.home)}>
      <span class="brand__name">RABOTA DOM</span>
      <span class="brand__descriptor">{nav.brandDescriptor}</span>
    </a>

    <div class="header__tools">
      <nav class="langs" aria-label={LOCALE_LABEL[locale]}>
        {
          LOCALES.map((code) => (
            <a
              href={getRelativeLocaleUrl(code, ROUTES.home)}
              hreflang={code}
              lang={code}
              dir={LOCALE_DIR[code]}
              aria-current={code === locale ? 'true' : undefined}
            >
              {LOCALE_LABEL[code]}
            </a>
          ))
        }
      </nav>
      <ThemeToggle labelLight={theme.toLight} labelDark={theme.toDark} />
    </div>
  </div>

  <nav class="nav" aria-label={nav.label}>
    <ul>
      {
        NAV_ORDER.map((key) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, ROUTES[key])}
              aria-current={key === current ? 'page' : undefined}
            >
              {nav[key]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    border-block-end: 1px solid var(--border-metal);
    background: var(--surface);
  }

  .header__row,
  .nav ul {
    margin-inline: auto;
    max-inline-size: 72rem;
    padding-inline: 1.5rem;
  }

  .header__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1rem 0.75rem;
  }

  .brand {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  .brand__name {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-brand);
    white-space: nowrap;
  }

  .brand__descriptor {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .langs {
    display: flex;
    /* Три названия языков при крупном шрифте не влезают в строку —
       перенос обязателен, иначе шапка выносит документ за край экрана. */
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.875rem;
    min-inline-size: 0;
  }

  .header__tools {
    min-inline-size: 0;
  }

  .langs a {
    color: var(--accent-text);
    text-underline-offset: 0.2em;
  }

  .langs a[aria-current] {
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding-block: 0 0.75rem;
  }

  .nav a {
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.9375rem;
    padding-block: 0.25rem;
    display: inline-block;
  }

  .nav a:hover {
    color: var(--accent-text);
  }

  /* Текущий раздел помечен и визуально, и для скринридера. */
  .nav a[aria-current='page'] {
    border-block-end: 2px solid var(--accent-wood);
  }
</style>
