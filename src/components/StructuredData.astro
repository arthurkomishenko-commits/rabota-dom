---
/**
 * Структурированные данные JSON-LD (бриф §2).
 *
 * Вход: готовый объект схемы. Выход: `<script type="application/ld+json">`.
 * Кто использует: страницы, у которых есть что описать машине.
 *
 * ПОЧЕМУ ОТДЕЛЬНЫЙ КОМПОНЕНТ, а не строка в каждой странице: разметка для
 * поисковика — это утверждение о бизнесе. Утверждение, собранное вручную
 * в пяти местах, разъедется, и часть страниц начнёт рассказывать о мастере
 * другое. Здесь один способ вывода и один способ экранирования.
 *
 * НИЧЕГО НЕ ВЫДУМЫВАЕТСЯ. В разметку попадает только то, что есть на самой
 * странице: рейтингов, отзывов-агрегатов и цен, которых мы не показываем
 * человеку, здесь тоже нет (бриф §4 — фейки запрещены; §1 — ценовая честность).
 */
interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;

/**
 * `</script>` внутри строки закрыл бы тег раньше времени. Экранируем здесь,
 * а не полагаемся на то, что в данных такого не встретится.
 */
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={json} />
