---
/**
 * Точка входа движения на странице.
 *
 * Что делает: поднимает сцену и раздаёт примитивы элементам, помеченным
 * в разметке. Выход: один модульный скрипт.
 * Кто использует: `PageLayout` — один раз на страницу.
 *
 * ПОЧЕМУ ОДНА ТОЧКА ВХОДА. Движение, раскиданное по компонентам, невозможно
 * ни продеградировать, ни убрать: «выключить анимации» превращается в перечень
 * мест, о которых кто-то должен помнить. Здесь одна сцена и одна уборка.
 *
 * ПОЧЕМУ РАЗМЕТКА ПОМЕЧАЕТ, А НЕ СКРИПТ ИЩЕТ ПО КЛАССАМ. `data-reveal` — это
 * заявление автора компонента «этот блок появляется». Класс — оформление,
 * и однажды его переименуют ради отступа, молча выключив движение.
 *
 * ЧЕГО ЗДЕСЬ НЕТ. Hero-сборки: она требует слоёв, которых ещё нет (Q-03),
 * и делается отдельным шагом на схематичных слоях собственной генерации.
 */
---

<script>
  /*
   * GSAP грузится ЛЕНИВО и это не оптимизация, а исправление BUG-0019.
   *
   * Модуль весит 43.5 КБ gz. На мобильной сети он скачивается одновременно
   * со шрифтом — а LCP-элементом главной является ТЕКСТ, которому этот шрифт
   * и нужен. В CI это стоило около полусекунды: 1940 → 2580 мс при пороге 2000,
   * причём TBT оставался нулевым, то есть скрипт ничего не исполнял и не
   * блокировал. Он просто занимал канал.
   *
   * Движение — усиление поверх готовой страницы. Значит оно обязано ждать,
   * пока страница загрузится, а не соревноваться с ней за полосу. Загрузка
   * начинается по первому из событий: простой браузера или первое движение
   * человека (прокрутка, указатель, клавиша) — то есть ровно тогда, когда
   * анимация может понадобиться.
   */
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (targets.length > 0) {
    let started = false;

    const start = async () => {
      if (started) return;
      started = true;

      const [{ createStage }, { reveal }] = await Promise.all([
        import('../lib/motion/stage'),
        import('../lib/motion/primitives'),
      ]);

      const stage = createStage(document.body, (api) => {
        for (const element of targets) {
          reveal(api, element, { stagger: element.hasAttribute('data-reveal-stagger') });
        }
      });

      /*
       * bfcache отдаёт страницу назад вместе с живыми таймлайнами, поэтому
       * уборка на `pagehide`, а не на `beforeunload`: второй в bfcache
       * попросту не срабатывает.
       */
      window.addEventListener('pagehide', () => stage.destroy(), { once: true });

      // Доступ для проверки «после уборки живых триггеров ноль»:
      // утверждение об уборке обязано быть измеримым, а не декларативным.
      (window as unknown as { __motion?: unknown }).__motion = stage;
      document.dispatchEvent(new CustomEvent('motion:ready'));
    };

    const onIdle = (window as unknown as {
      requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => void;
    }).requestIdleCallback;

    for (const event of ['scroll', 'pointerdown', 'keydown'] as const) {
      window.addEventListener(event, start, { once: true, passive: true });
    }

    if (onIdle) onIdle(() => start(), { timeout: 3000 });
    else window.addEventListener('load', () => start(), { once: true });
  }
</script>
