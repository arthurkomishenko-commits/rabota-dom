---
/**
 * Главная страница: десять экранов по брифу §3.
 *
 * Вход: словарь, работы, адреса — через props. Выход: содержимое страницы.
 * Кто использует: `/`, `/ru/`, `/en/`.
 *
 * ГЕЙТЫ ПОКАЗА — не украшение, а требование брифа:
 *  · «последние проекты» появляются при ≥3 полных паспортах (§3);
 *  · тизер карты — при ≥6 точках (§5);
 *  · видео и «до/после» — только при наличии ассетов (§4).
 * Экран без данных исчезает ЦЕЛИКОМ. Заглушки «скоро здесь будет» не бывает:
 * пустое место выглядит недоделанным ровно там, где сайт должен выглядеть
 * спокойным. Сейчас паспортов два — значит четыре экрана скрыты, и это норма.
 *
 * Hero статичный: сборка приходит в F5. Портрет мастера — ассета нет,
 * поэтому блока портрета тоже нет.
 */
import Button from './Button.astro';
import WorkCard from './WorkCard.astro';
import type { Dictionary } from '../data/dictionary';
import type { WorkEntry } from '../data/works';

interface Props {
  dict: Dictionary;
  works: WorkEntry[];
  /** Полные паспорта — по ним считается гейт «последних проектов». */
  portfolioHref: string;
  contactHref: string;
  workHref: (slug: string) => string;
  whatsappUrl: string;
  phoneHref: string;
  phoneDisplay: string;
  mapPoints: number;
  mapHref: string;
  heroImage?: { src: string; width: number; height: number; alt: string };
}

const {
  dict,
  works,
  portfolioHref,
  contactHref,
  workHref,
  whatsappUrl,
  phoneHref,
  phoneDisplay,
  mapPoints,
  mapHref,
  heroImage,
} = Astro.props;

const t = dict.home;

/*
 * Сколько паспортов нужно, чтобы показать блок работ на главной.
 *
 * Было 3 — и это число выбиралось, когда все работы стояли на схемах: сетка
 * из двух чертежей выглядела бедно. С настоящими фотографиями расчёт
 * обратный: одна карточка с живым кадром честнее восьми экранов сплошного
 * текста, а именно так главная и выглядела. Разбор — DEC-0023.
 */
const MIN_LATEST = 1;
const MIN_MAP_POINTS = 6;

const showLatest = works.length >= MIN_LATEST;
const showMapTeaser = mapPoints >= MIN_MAP_POINTS;
const steps = [dict.about.step1, dict.about.step2, dict.about.step3, dict.about.step4];
const principles = [dict.about.principle1, dict.about.principle2, dict.about.principle3];
---

{/* ── 1. Hero ─────────────────────────────────────────────────────────── */}
<section class="hero">
  <div class="hero__inner">
    <p class="hero__kicker">{t.heroKicker}</p>
    <h1>{t.heroTitle}</h1>
    <p class="hero__lead">{t.heroLead}</p>

    {/* Иерархия CTA из брифа §3: две кнопки, телефон — вторичной ссылкой. */}
    <div class="hero__cta">
      <Button href={whatsappUrl} rel="noopener" target="_blank">WhatsApp</Button>
      <Button href={contactHref}>{t.heroCta}</Button>
    </div>
    <p class="hero__phone">
      <Button variant="text" href={phoneHref}>{t.heroCallLabel}: {phoneDisplay}</Button>
    </p>
  </div>

  {
    heroImage && (
      <div class="hero__media">
        <img
          src={heroImage.src}
          alt={heroImage.alt}
          width={heroImage.width}
          height={heroImage.height}
          decoding="async"
          fetchpriority="high"
        />
      </div>
    )
  }
</section>

{/* ── 2. Почему доверяют ──────────────────────────────────────────────── */}
<section class="band">
  <div class="band__inner">
    <h2>{t.trustTitle}</h2>
    <ul class="trust" data-reveal data-reveal-stagger>
      {/* Траст-формула брифа §1 — дословно, первым пунктом. */}
      <li class="trust__main">{dict.about.trustFormula}</li>
      <li>{t.trustPoint2}</li>
      <li>{t.trustPoint3}</li>
    </ul>
  </div>
</section>

{/* ── 3. Последние проекты · гейт ≥3 паспортов ────────────────────────── */}
{
  showLatest && (
    <section class="band">
      <div class="band__inner">
        <h2>{t.latestTitle}</h2>
        <div class="latest" data-reveal data-reveal-stagger>
          {works.slice(0, 3).map((work, index) => (
            <WorkCard
              priority={index === 0}
              title={work.data.title}
              city={work.data.city}
              year={work.data.year}
              unitLabels={dict.units}
              locale={dict.locale}
              material={dict.materials[work.data.material]}
              demoLabel={work.data.demo ? dict.demo.badge : undefined}
              href={workHref(work.data.slug)}
              photo={{ image: work.data.photos[0]!.src, alt: work.data.photos[0]!.alt }}
              metrics={work.data.metrics}
            />
          ))}
        </div>
        <p><a class="more" href={portfolioHref}>{t.latestAll}</a></p>
      </div>
    </section>
  )
}

{/* ── 4. Видео процесса · ассета нет → экрана нет ─────────────────────── */}
{/* ── 5. Как проходит работа ─────────────────────────────────────────── */}
<section class="band">
  <div class="band__inner">
    <h2>{t.howTitle}</h2>
    <ol class="steps" data-reveal data-reveal-stagger>{steps.map((step) => <li>{step}</li>)}</ol>
  </div>
</section>

{/* ── 6. До/После · пар нет → экрана нет ──────────────────────────────── */}
{/* ── Тизер карты · гейт ≥6 точек ─────────────────────────────────────── */}
{
  showMapTeaser && (
    <section class="band">
      <div class="band__inner">
        <h2>{t.mapTeaserTitle}</h2>
        <p>{t.mapTeaserBody}</p>
        <p><a class="more" href={mapHref}>{t.mapTeaserCta}</a></p>
      </div>
    </section>
  )
}

{/* ── 8. Принципы мастера ─────────────────────────────────────────────── */}
<section class="band">
  <div class="band__inner">
    <h2>{t.principlesTitle}</h2>
    <ul class="principles" data-reveal data-reveal-stagger>{principles.map((item) => <li>{item}</li>)}</ul>
  </div>
</section>

{/* ── 9. FAQ · на <details>, работает без JS ──────────────────────────── */}
<section class="band">
  <div class="band__inner">
    <h2>{t.faqTitle}</h2>
    <div class="faq">
      {
        /*
         * Первые три вопроса — цена, гарантия, срок. Ради них страницу
         * и листают до конца, поэтому они открыты: свёрнутый ответ на
         * главный вопрос — это лишний клик там, где человек уже решает.
         */
        dict.faq.map((item, index) => (
          <details class="faq__item" open={index < 3}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

{/*
  ── Мини-форма ─────────────────────────────────────────────────────────
  Стоит ПОСЛЕ вопросов и ответов. Раньше она была седьмым экраном из десяти,
  то есть телефон просили до того, как ответили «сколько стоит» и «есть ли
  гарантия». Порядок «сначала ответы, потом просьба» — не вежливость,
  а работающая последовательность.
*/}
<section class="band band--form">
  <div class="band__inner">
    <h2>{t.formTitle}</h2>
    <p>{t.formLead}</p>
    {/*
      Обёртка обязательна. Содержимое `<slot>` принадлежит области видимости
      СТРАНИЦЫ, а не этого компонента, поэтому scoped-правило
      `.band__inner > :not(h2)` до него не достаёт: у слотированного узла нет
      атрибута области. Без обёртки форма выпадала из колонки содержимого
      и вставала под заголовком, шириной в 14rem.
    */}
    <div class="band__slot"><slot name="form" /></div>
  </div>
</section>

{/* ── 10. Финальный CTA ───────────────────────────────────────────────── */}
<section class="band band--final">
  <div class="band__inner">
    <h2>{t.finalTitle}</h2>
    <p>{t.finalLead}</p>
    <div class="hero__cta">
      <Button href={whatsappUrl} rel="noopener" target="_blank">WhatsApp</Button>
      <Button href={contactHref}>{t.heroCta}</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    border-block-end: 1px solid var(--border-metal);
  }

  .hero__inner,
  .band__inner {
    margin-inline: auto;
    max-inline-size: 72rem;
    padding-inline: 1.5rem;
  }

  .hero__inner {
    padding-block: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .hero__kicker {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 500;
    line-height: var(--line-height-heading);
  }

  .hero__lead {
    margin: 0;
    max-inline-size: var(--measure);
    font-size: 1.0625rem;
    color: var(--text-muted);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__phone {
    margin: 0;
  }

  .hero__media img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    max-block-size: 60dvh;
    object-fit: cover;
  }

  .band {
    border-block-end: 1px solid var(--border-metal);
  }

  .band__inner {
    padding-block: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  /*
   * Широкий экран: заголовок секции уходит в собственную колонку у края,
   * содержимое встаёт рядом. Раньше всё выстраивалось одним столбцом
   * у внутреннего края полосы, и на 1440 половина холста оставалась пустой —
   * не «воздухом», а незанятым местом: в нём не было ни ритма, ни линии.
   * Заодно появляется иерархия: три секции подряд перестают выглядеть
   * одинаковыми блоками «заголовок и три строки».
   *
   * Логические свойства обязательны: в иврите колонка заголовка — правая.
   */
  @media (min-width: 64rem) {
    .band__inner {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: 3rem;
      row-gap: 1rem;
      align-items: start;
    }

    .band__inner > h2 {
      grid-column: 1;
      /* Оптическая привязка к первой строке текста рядом. */
      margin-block-start: 0.2rem;
    }

    .band__inner > :not(h2) {
      grid-column: 2;
    }

    .band__slot {
      inline-size: 100%;
    }
  }

  h2 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 500;
  }

  .band p {
    margin: 0;
    max-inline-size: var(--measure);
  }

  .trust,
  .principles,
  .steps {
    margin: 0;
    max-inline-size: var(--measure);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .trust,
  .principles {
    list-style: none;
    padding: 0;
  }

  .steps {
    padding-inline-start: 1.25rem;
  }

  .trust__main {
    border-inline-start: 3px solid var(--accent-wood);
    padding-inline-start: 1rem;
  }

  /*
   * `auto-fill` резервирует пустые колонки: при двух работах сетка держала
   * четыре трека, и две трети полосы оставались пустыми. `auto-fit` схлопывает
   * пустые треки, потолок в 22rem не даёт двум карточкам растянуться в лапти.
   */
  .latest {
    inline-size: 100%;
    display: grid;
    /*
     * `min(16rem, 100%)` — не украшение. Голый `minmax(16rem, …)` задаёт
     * колонке минимум, который сетка обязана соблюсти даже когда он шире
     * контейнера. А `rem` растёт вместе с крупным шрифтом панели доступности:
     * на 320px с третьим уровнем 16rem превращались в 384px, и документ
     * разъезжался до 420. Поймано полировкой сразу на трёх движках.
     * `min(…, 100%)` разрешает колонке сжаться до ширины полосы.
     */
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 22rem));
    gap: 1.25rem;
  }

  .more {
    color: var(--accent-text);
  }

  .faq {
    inline-size: 100%;
    max-inline-size: var(--measure);
    border-block-start: 1px solid var(--border-metal);
  }

  .faq__item {
    border-block-end: 1px solid var(--border-metal);
  }

  .faq__item summary {
    cursor: pointer;
    padding-block: 0.875rem;
    font-weight: 500;
    /* Цель для пальца не меньше 44px по высоте. */
    min-block-size: 44px;
    display: flex;
    align-items: center;
  }

  .faq__item p {
    margin: 0;
    padding-block-end: 1rem;
    color: var(--text-muted);
  }

  .band--form,
  .band--final {
    background: var(--surface);
  }
</style>
