---
/**
 * Раздел витрины: тег материала и карточка-«паспорт объекта».
 * Показывает три случая: полная карточка, карточка без метрик и карточка
 * с очень длинным названием — фейков быть не должно ни в одном (бриф §4).
 * Вход: нет. Выход: раздел. Кто использует: `src/showcase/index.astro`.
 *
 * Фото — реальная работа Владимира, 1600×1200 (4:3). Через Vite (?url),
 * поэтому путь получает хэш и base автоматически.
 */
import Specimen from '../Specimen.astro';
import MaterialTag from '../../components/MaterialTag.astro';
import WorkCard from '../../components/WorkCard.astro';
// Витрина показывает НАШУ схему, а не работу клиента: BUG-0013, DEC-0022.
import photoImage from '../demo/pergola-scheme.jpg';
import { getDictionary } from '../../data/dictionary';

const demoDict = getDictionary('ru');
const units = demoDict.units;

const PHOTO = {
  image: photoImage,
  alt: 'Алюминиевая пергола с ламелями над мощёной площадкой во дворе',
};
---

<Specimen title="Тег материала">
  <div class="row">
    <MaterialTag>Алюминий</MaterialTag>
    <MaterialTag>עץ</MaterialTag>
    <MaterialTag>Комбо</MaterialTag>
  </div>
</Specimen>

<Specimen
  title="Карточка-«паспорт объекта»"
  note="Спил среза зеркалится в RTL. Метрика без значения не рендерится вообще — ни подписи, ни прочерка (бриф §4: фейки запрещены)."
>
  <div class="cards">
    <WorkCard
      title="Пергола с ламелями"
      city="Ноф-ха-Галиль"
      year={{ kind: 'year', value: 2024 }}
      unitLabels={units}
      locale={demoDict.locale}
      material="Алюминий"
      photo={PHOTO}
      href="#work"
      metrics={[
        { label: 'Площадь', value: { kind: 'quantity', value: 18, unit: 'm2' } },
        { label: 'Профиль', value: { kind: 'dimensions', a: 100, b: 50, unit: 'mm' } },
      ]}
    />
    <WorkCard
      title="Навес во дворе"
      city="Мигдаль-ха-Эмек"
      year={{ kind: 'year', value: 2023 }}
      unitLabels={units}
      locale={demoDict.locale}
      material="Комбо"
      photo={PHOTO}
      metrics={[]}
    />
    <WorkCard
      title="Ламельнаяперголасоченьдлиннымнеразрывнымназванием"
      city="Кирьят-Тивон"
      year={{ kind: 'year', value: 2025 }}
      unitLabels={units}
      locale={demoDict.locale}
      material="Дерево"
      photo={PHOTO}
      metrics={[{ label: 'Длина', value: { kind: 'quantity', value: 24, unit: 'lm' } }]}
    />
  </div>
</Specimen>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }
</style>
