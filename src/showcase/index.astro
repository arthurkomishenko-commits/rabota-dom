---
/**
 * Витрина компонентов, фаза F1.
 *
 * Что делает: собирает разделы витрины в одну страницу. Каждый раздел живёт
 * своим файлом в `sections/` — одна ответственность на файл (§5).
 * Вход: нет. Выход: страница `/__ui/`.
 *
 * В production-сборке этого маршрута НЕ СУЩЕСТВУЕТ: он инжектится интеграцией
 * `rabota-dom:ui-showcase` только при `UI_SHOWCASE=1` (DEC-0011).
 * Открывается через `npm run dev` или `npm run build:ui`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import PaletteSection from './sections/PaletteSection.astro';
import FocusSection from './sections/FocusSection.astro';
import ButtonSection from './sections/ButtonSection.astro';
import FieldSection from './sections/FieldSection.astro';
import CardSection from './sections/CardSection.astro';
import WorksSection from './sections/WorksSection.astro';
import ChannelsSection from './sections/ChannelsSection.astro';
import PhotoDimSection from './sections/PhotoDimSection.astro';
---

<BaseLayout locale="en" title="Rabota Dom — UI showcase" noindex>
  <main class="ui">
    <header class="ui__head">
      <div>
        <p class="ui__kicker">Rabota Dom · F1</p>
        <h1 class="ui__title">Витрина компонентов</h1>
      </div>
      <ThemeToggle labelLight="Светлая тема" labelDark="Тёмная тема" />
    </header>

    <p class="ui__note">
      Страница существует только в сборке с <code>UI_SHOWCASE=1</code>. В production
      её маршрута нет — прятать нечего. Тему переключайте тумблером, направление
      показано в каждом образце сразу обоими вариантами.
    </p>

    <PaletteSection />
    <FocusSection />
    <ButtonSection />
    <FieldSection />
    <CardSection />
    <WorksSection />
    <ChannelsSection />
    <PhotoDimSection />
  </main>
</BaseLayout>

<script>
  // Подписываем реальные вычисленные значения токенов — чтобы на скрине было
  // видно не только цвет, но и то, чем он задан в текущей теме.
  function paintValues() {
    const styles = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLElement>('[data-token]').forEach((node) => {
      const token = node.dataset.token;
      if (token) node.textContent = styles.getPropertyValue(token).trim();
    });
  }

  paintValues();
  new MutationObserver(paintValues).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>

<style>
  .ui {
    margin-inline: auto;
    max-inline-size: 72rem;
    padding-inline: 1.5rem;
    padding-block: 2.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .ui__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-block-end: 1px solid var(--border-metal);
    padding-block-end: 1rem;
  }

  .ui__kicker {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    letter-spacing: var(--tracking-brand);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ui__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
  }

  .ui__note {
    margin: 0;
    max-inline-size: var(--measure);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125em;
  }
</style>
