---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { DEFAULT_LOCALE, LOCALES, LOCALE_DIR, type Locale } from '../config/site';
import { getRouteKey, isNonLocalizedPath } from '../lib/i18n';

// Сабсеты грузим через Vite (?url): так preload указывает ровно на тот же
// хэшированный файл, что подставится в @font-face, и base учитывается сам.
import rubikHebrew from '../styles/fonts/rubik-hebrew-wght-normal.woff2?url';
import rubikCyrillic from '../styles/fonts/rubik-cyrillic-wght-normal.woff2?url';
import rubikLatin from '../styles/fonts/rubik-latin-wght-normal.woff2?url';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
  /**
   * Имя OG-карточки без расширения. По умолчанию — общая карточка локали.
   * Карточки рисуются браузером до сборки (`npm run og`): satori не прошёл
   * визуальный тест иврита — переставлял буквы внутри слов и не находил
   * глифы цифр (бриф §7 предусматривал этот фоллбек, DEC-0019).
   */
  ogCard?: string;
}

const { locale, title, description, noindex = false, ogCard } = Astro.props;

const dir = LOCALE_DIR[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  `${import.meta.env.BASE_URL}og/${ogCard ?? `site-${locale}`}.png`,
  Astro.site,
);

// Вне языковой матрицы (/admin) hreflang не строим — бриф §2.
const localized = !isNonLocalizedPath(Astro.url.pathname);
const routeKey = getRouteKey(Astro.url.pathname);

const alternates = localized
  ? LOCALES.map((code) => ({ code, href: getAbsoluteLocaleUrl(code, routeKey) }))
  : [];

// x-default → ивритская версия того же маршрута (для главной это буквально '/').
const xDefault = localized ? getAbsoluteLocaleUrl(DEFAULT_LOCALE, routeKey) : null;

// Предзагружаем только сабсет языка страницы. Латиница (лого) догрузится
// обычным путём со swap — держим бюджет критического пути минимальным.
const preloadFont =
  locale === 'he' ? rubikHebrew : locale === 'ru' ? rubikCyrillic : rubikLatin;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Каскад темы: localStorage → prefers-color-scheme → light.
      Плюс режимы панели доступности — ОДНИМ проходом, до стилей и без внешнего
      файла. Два отдельных скрипта дали бы два кадра перерисовки; здесь и тема,
      и режимы встают до первой отрисовки (бриф §2, §15).
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;

        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch (e) {
          /* приватный режим — остаётся светлая */
        }
        root.dataset.theme = theme;

        try {
          var a11y = JSON.parse(localStorage.getItem('a11y') || '{}');
          for (var key in a11y) {
            if (a11y[key]) root.setAttribute('data-a11y-' + key, a11y[key]);
          }
        } catch (e) {
          /* настроек нет или они испорчены — идём с обычными */
        }
      })();
    </script>

    <link
      rel="preload"
      href={preloadFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/*
      Canonical только для страниц языковой матрицы. У 404 канонического
      адреса не существует по определению: она отдаётся на любой запрос,
      и объявлять «правильный» адрес значит указывать на несуществующую
      страницу. У `/admin` он бессмыслен по той же причине. Найдено
      проверкой целостности, BUG-0011.
    */}
    {localized && <link rel="canonical" href={canonical.href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rabota Dom" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      alternates.map(({ code, href }) => (
        <link rel="alternate" hreflang={code} href={href} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <slot />
  </body>
</html>
