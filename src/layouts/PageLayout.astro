---
/**
 * Каркас обычной страницы: шапка, содержимое, подвал, ссылка «к содержимому».
 *
 * Вход: локаль, заголовок, описание, ключ маршрута. Выход: полная страница.
 * Кто использует: все страницы в `src/pages/`.
 *
 * Отдельный слой поверх `BaseLayout`: тот отвечает за документ (lang, hreflang,
 * каскад темы, шрифты), этот — за обвязку страницы. Витрина и `/admin`
 * пользуются только BaseLayout, поэтому шапка на них не появляется.
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AccessibilityPanel from '../components/AccessibilityPanel.astro';
import StickyChannels from '../components/StickyChannels.astro';
import type { Dictionary } from '../data/dictionary';
import type { ROUTES, Locale } from '../config/site';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  current?: keyof typeof ROUTES;
  noindex?: boolean;
  /**
   * Словарь приходит props'ом, а не импортом: слой layouts не имеет права
   * знать, откуда берутся данные (ARCHITECTURE_PRINCIPLES §2). Поймано
   * проверкой границ при первой же попытке импортировать напрямую.
   */
  nav: Dictionary['nav'];
  theme: Dictionary['theme'];
  a11y: Dictionary['a11y'];
  contact: Dictionary['contact'];
  /** Адреса каналов и декларации — из конфига, компонент их не знает. */
  whatsappUrl: string;
  phoneHref: string;
  contactHref: string;
  declarationHref: string;
}

const {
  locale,
  title,
  description,
  current,
  noindex = true,
  nav,
  theme,
  a11y,
  contact,
  whatsappUrl,
  phoneHref,
  contactHref,
  declarationHref,
} = Astro.props;
---

<BaseLayout locale={locale} title={title} description={description} noindex={noindex}>
  <a class="skip" href="#main">{nav.skipToContent}</a>
  <SiteHeader locale={locale} nav={nav} theme={theme} current={current} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter locale={locale} nav={nav} />

  {/* Три равноправных канала — только на узких экранах (бриф §3). */}
  <div class="sticky-slot">
    <StickyChannels
      label={contact.title}
      whatsapp={{ label: contact.whatsapp, href: whatsappUrl }}
      call={{ label: contact.call, href: phoneHref }}
      request={{ label: contact.formTitle, href: contactHref }}
    />
  </div>

  <AccessibilityPanel a11y={a11y} declarationHref={declarationHref} />
</BaseLayout>

<style>
  /**
   * Ссылка видна только при клавиатурном фокусе. Не `display: none` —
   * скрытый таким образом элемент недостижим и с клавиатуры тоже.
   */
  .skip {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    transform: translateY(-120%);
    z-index: 100;
    background: var(--surface);
    color: var(--text-main);
    border: 1px solid var(--border-metal);
    padding-block: 0.75rem;
    padding-inline: 1rem;
    text-decoration: none;
  }

  .skip:focus-visible {
    transform: translateY(0);
  }

  main:focus {
    outline: none;
  }

  /**
   * Sticky-панель показывается только на узких экранах: на десктопе три канала
   * уже есть в шапке и на странице контактов, и полоса внизу была бы шумом.
   * Отступ снизу отдаётся телу страницы, иначе панель накрыла бы подвал.
   */
  .sticky-slot {
    display: none;
  }

  @media (max-width: 48rem) {
    .sticky-slot {
      display: block;
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 65;
    }

    :global(body) {
      padding-block-end: 4rem;
    }
  }
</style>
