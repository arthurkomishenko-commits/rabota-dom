---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { ROUTES , WHATSAPP_URL, PHONE_HREF } from '../../config/site';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDictionary } from '../../data/dictionary';

const locale = 'ru' as const;
const dict = getDictionary(locale);
const t = dict.legal;

const sections = [
  { heading: t.privacyWhat, body: t.privacyWhatBody },
  { heading: t.privacyWhy, body: t.privacyWhyBody },
  { heading: t.privacyKeep, body: t.privacyKeepBody },
  { heading: t.privacyReviews, body: t.privacyReviewsBody },
  { heading: t.privacyRights, body: t.privacyRightsBody },
];
---

<PageLayout
  locale={locale}
  nav={dict.nav}
  theme={dict.theme}
  a11y={dict.a11y}
  contact={dict.contact}
  whatsappUrl={WHATSAPP_URL}
  phoneHref={PHONE_HREF}
  contactHref={getRelativeLocaleUrl(locale, ROUTES.contact)}
  declarationHref={getRelativeLocaleUrl(locale, ROUTES.accessibility)}
  title={t.privacyTitle}
  description={t.privacyIntro}
  current="privacy"
>
  <LegalPage
    title={t.privacyTitle}
    intro={t.privacyIntro}
    sections={sections}
    updatedLabel={t.updated}
    updatedDate="2026-08-10"
  />
</PageLayout>
