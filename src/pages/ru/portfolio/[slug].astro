---
import PageLayout from '../../../layouts/PageLayout.astro';
import WorkDetail from '../../../components/WorkDetail.astro';
import { getDictionary } from '../../../data/dictionary';
import { ROUTES , WHATSAPP_URL, PHONE_HREF } from '../../../config/site';
import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
  const { getWorks: load } = await import('../../../data/works');
  const works = await load('ru');
  return works.map((work) => ({ params: { slug: work.data.slug }, props: { work } }));
}

const locale = 'ru' as const;
const dict = getDictionary(locale);
const { work } = Astro.props;
const backHref = getRelativeLocaleUrl(locale, ROUTES.portfolio);
---

<PageLayout
  locale={locale}
  nav={dict.nav}
  theme={dict.theme}
  a11y={dict.a11y}
  contact={dict.contact}
  whatsappUrl={WHATSAPP_URL}
  phoneHref={PHONE_HREF}
  contactHref={getRelativeLocaleUrl(locale, ROUTES.contact)}
  declarationHref={getRelativeLocaleUrl(locale, ROUTES.accessibility)}
  title={`${work.data.title} — Rabota Dom`}
  description={work.data.summary}
  current="portfolio"
>
  <WorkDetail work={work} dict={dict} backHref={backHref} />
</PageLayout>
