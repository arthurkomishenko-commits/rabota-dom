---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FoundationCheck from '../../components/FoundationCheck.astro';
import { UI } from '../../i18n/ui';

const locale = 'ru' as const;
---

{/* noindex снимается в F8 вместе с Content Freeze — до запуска сайт staging. */}
<BaseLayout locale={locale} title={UI[locale].scaffoldTitle} noindex>
  <FoundationCheck locale={locale} />
</BaseLayout>
