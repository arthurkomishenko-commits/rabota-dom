---
import PageLayout from '../../layouts/PageLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import { service } from '../../lib/structured-data';
import ServicePage from '../../components/ServicePage.astro';
import { getDictionary } from '../../data/dictionary';
import { getWorks } from '../../data/works';
import { ROUTES , WHATSAPP_URL, PHONE_HREF } from '../../config/site';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = 'en' as const;
const dict = getDictionary(locale);
const t = dict.services;
const works = (await getWorks(locale)).filter((work) => work.data.type === 'canopy');

const workHref = (slug: string) => getRelativeLocaleUrl(locale, `${ROUTES.portfolio}${slug}/`);
const schema = service({
  siteUrl: Astro.site?.href ?? '',
  name: t.canopyTitle,
  description: t.canopyLead,
  providerName: 'Rabota Dom',
  areaServed: [dict.about.lead.split('.')[0] ?? ''],
});

const contactHref = getRelativeLocaleUrl(locale, ROUTES.contact);
---

<PageLayout
  locale={locale}
  nav={dict.nav}
  theme={dict.theme}
  a11y={dict.a11y}
  contact={dict.contact}
  whatsappUrl={WHATSAPP_URL}
  phoneHref={PHONE_HREF}
  contactHref={getRelativeLocaleUrl(locale, ROUTES.contact)}
  declarationHref={getRelativeLocaleUrl(locale, ROUTES.accessibility)}
  title={`${t.canopyTitle} — Rabota Dom`}
  description={t.canopyLead}
  current="services"
>
  <StructuredData data={schema} />
  <ServicePage
    title={t.canopyTitle}
    lead={t.canopyLead}
    what={t.canopyWhat}
    materialsText={t.canopyMaterials}
    priceText={t.canopyPrice}
    dict={dict}
    works={works}
    workHref={workHref}
    contactHref={contactHref}
  />
</PageLayout>
