---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { getDictionary } from '../../data/dictionary';

const locale = 'en' as const;
const dict = getDictionary(locale);
const t = dict.legal;

const sections = [
  { heading: t.accessibilityDone, body: t.accessibilityDoneBody },
  { heading: t.accessibilityLimits, body: t.accessibilityLimitsBody },
];
---

<PageLayout
  locale={locale} nav={dict.nav} theme={dict.theme}
  title={t.accessibilityTitle}
  description={t.accessibilityIntro}
  current="accessibility"
>
  <LegalPage
    title={t.accessibilityTitle}
    intro={t.accessibilityIntro}
    sections={sections}
    note={t.accessibilityContact}
    updatedLabel={t.updated}
    updatedDate="2026-08-10"
  />
</PageLayout>
