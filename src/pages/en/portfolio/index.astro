---
import PageLayout from '../../../layouts/PageLayout.astro';
import PortfolioList from '../../../components/PortfolioList.astro';
import { getDictionary } from '../../../data/dictionary';
import { getWorks } from '../../../data/works';
import { ROUTES , WHATSAPP_URL, PHONE_HREF } from '../../../config/site';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = 'en' as const;
const dict = getDictionary(locale);
const t = dict.portfolio;
const works = await getWorks(locale);

const basePath = getRelativeLocaleUrl(locale, ROUTES.portfolio);
const workHref = (slug: string) => getRelativeLocaleUrl(locale, `${ROUTES.portfolio}${slug}/`);
---

<PageLayout
  locale={locale}
  nav={dict.nav}
  theme={dict.theme}
  a11y={dict.a11y}
  contact={dict.contact}
  whatsappUrl={WHATSAPP_URL}
  phoneHref={PHONE_HREF}
  contactHref={getRelativeLocaleUrl(locale, ROUTES.contact)}
  declarationHref={getRelativeLocaleUrl(locale, ROUTES.accessibility)}
  title={`${t.title} — Rabota Dom`}
  description={t.intro}
  current="portfolio"
>
  <section class="page">
    <h1>{t.title}</h1>
    <p class="page__intro">{t.intro}</p>
    <PortfolioList works={works} dict={dict} basePath={basePath} workHref={workHref} />
  </section>
</PageLayout>

<style>
  .page {
    margin-inline: auto;
    max-inline-size: 72rem;
    padding-inline: 1.5rem;
    padding-block: 2.5rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.875rem;
    font-weight: 500;
  }

  .page__intro {
    margin: 0 0 2rem;
    max-inline-size: var(--measure);
    color: var(--text-muted);
  }
</style>
