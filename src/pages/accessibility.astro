---
import PageLayout from '../layouts/PageLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { ROUTES , WHATSAPP_URL, PHONE_HREF } from '../config/site';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDictionary } from '../data/dictionary';

const locale = 'he' as const;
const dict = getDictionary(locale);
const t = dict.legal;

const sections = [
  { heading: t.accessibilityDone, body: t.accessibilityDoneBody },
  { heading: t.accessibilityLimits, body: t.accessibilityLimitsBody },
];
---

<PageLayout
  locale={locale} nav={dict.nav} theme={dict.theme}
  a11y={dict.a11y}
  contact={dict.contact}
  whatsappUrl={WHATSAPP_URL}
  phoneHref={PHONE_HREF}
  contactHref={getRelativeLocaleUrl(locale, ROUTES.contact)}
  declarationHref={getRelativeLocaleUrl(locale, ROUTES.accessibility)}
  title={t.accessibilityTitle}
  description={t.accessibilityIntro}
  current="accessibility"
>
  <LegalPage
    title={t.accessibilityTitle}
    intro={t.accessibilityIntro}
    sections={sections}
    note={t.accessibilityContact}
    updatedLabel={t.updated}
    updatedDate="2026-08-10"
  />
</PageLayout>
