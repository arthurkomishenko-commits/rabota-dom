{
  "name": "rabota-dom",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "UI_SHOWCASE=1 astro dev",
    "build": "npm run check:conventions && npm run check:markers && npm run check:budgets && npm run check:contrast && astro build && npm run check:surface",
    "preview": "astro preview",
    "astro": "astro",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "check:types": "astro check",
    "check": "npm run check:conventions && npm run check:markers && npm run check:budgets && npm run check:contrast && npm run check:selftest && npm run check:types",
    "check:budgets": "node scripts/check-budgets.mjs",
    "gate:f0": "node scripts/gate-f0.mjs",
    "check:markers": "node scripts/check-markers.mjs",
    "check:selftest": "node scripts/selftest-checks.mjs",
    "polish": "npm run build && node scripts/polish-pass.mjs",
    "build:ui": "npm run check:conventions && npm run check:markers && npm run check:budgets && npm run check:contrast && UI_SHOWCASE=1 astro build",
    "check:surface": "node scripts/check-public-surface.mjs",
    "shots:ui": "npm run build:ui && node scripts/shots-ui.mjs",
    "polish:ui": "npm run build:ui && node scripts/polish-pass.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "tailwindcss": "^4.3.3"
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/rubik": "^5.3.0",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  }
}
